  "compatibility_date": "2024-06-05",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.hystersis.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BACKEND_ORIGIN": "http://ec2-54-87-249-176.compute-1.amazonaws.com:8081"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-memorydash",
  "account_id": "c50d52c51722d57e2c06c3eab5510dc3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm ci --legacy-peer-deps && export BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-ci-placeholder-secret-at-least-32-chars-long} && npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "app.hystersis.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.hystersis.com",
    "BETTER_AUTH_URL": "https://app.hystersis.com"
  }
}

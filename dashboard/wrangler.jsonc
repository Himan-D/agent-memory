{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hystersis-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm ci && npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "app.hystersis.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}

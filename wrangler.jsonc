{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-memory",
  "main": "workers/site.js",
  "compatibility_date": "2026-06-05",
  "build": {
    "command": "npm --prefix landing ci && npm --prefix landing run build && bash scripts/build-docs.sh"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "hystersis.com",
      "custom_domain": true
    },
    {
      "pattern": "www.hystersis.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "landing/dist",
    "not_found_handling": "single-page-application"
  }
}

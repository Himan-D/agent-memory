# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_URL=localhost:6333
QDRANT_API_KEY=

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=text-embedding-3-small

# Enterprise SSO
SSO_CONFIG_FILE=./data/sso-providers.json
# SSO_PROVIDERS_JSON can be either {"providers":[...]} or a raw array.
# SSO_PROVIDERS_JSON={"providers":[{"tenant_id":"acme","provider_type":"oidc","client_id":"...","client_secret":"...","issuer_url":"https://idp.example.com"}]}

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_URL=localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memory_ollama
QDRANT_VECTOR_SIZE=768

# OpenAI (for embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBED_URL=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_EMBED_DIM=768

# Enterprise SSO
SSO_CONFIG_FILE=./data/sso-providers.json
# SSO_PROVIDERS_JSON can be either {"providers":[...]} or a raw array.
# SSO_PROVIDERS_JSON={"providers":[{"tenant_id":"acme","provider_type":"oidc","client_id":"...","client_secret":"...","issuer_url":"https://idp.example.com"}]}

ADMIN_API_KEY=
ADMIN_SCOPED_API_KEY=
USER_API_KEY=

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=
EVALUATOR_MODEL=

COMPRESSION_LLM_VERIFY_PROVIDER=
COMPRESSION_LLM_VERIFY_MODEL=
COMPRESSION_VERIFY_API_KEY=
COMPRESSION_VERIFY_BASE_URL=